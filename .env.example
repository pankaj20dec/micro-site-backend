PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fipo_db?schema=public"

# DigitalOcean managed Postgres (copy Connection string from Control Panel):
# DATABASE_URL="postgresql://doadmin:PASSWORD@your-cluster.db.ondigitalocean.com:25060/defaultdb?sslmode=require"
# No extra vars needed — sslmode=require is auto-detected. See:
# https://docs.digitalocean.com/products/databases/postgresql/how-to/connect/
#
# Optional verify-full (download CA cert from DO dashboard):
# DATABASE_URL="postgresql://doadmin:PASSWORD@your-cluster.db.ondigitalocean.com:25060/defaultdb?sslmode=verify-full"
# DATABASE_SSL_CA=/etc/ssl/certs/ca-certificate.crt
JWT_SECRET=replace-with-long-random-string
# Comma-separated browser origins allowed to call the API (must match where the Next app runs)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_MODE=sandbox
# GBP for UK sandbox; use USD only if your sandbox business account is US-based
PAYPAL_CURRENCY=GBP

# DigitalOcean Spaces
DO_SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
DO_SPACES_REGION=ams3
DO_SPACES_BUCKET=fipo-documents
DO_SPACES_KEY=...
DO_SPACES_SECRET=...
DO_SPACES_CDN_ENDPOINT=https://fipo-documents.ams3.cdn.digitaloceanspaces.com

# DocuSign (demo: account-d.docusign.com | production: account.docusign.com)
# 1. Create Integration Key + RSA keypair in DocuSign Admin → Apps and Keys
# 2. Grant consent once: click "Grant consent in DocuSign" on register page (redirect URI must match)
#    Default redirect: {APP_BASE_URL}/callback — e.g. https://46-101-60-110.sslip.io/callback
#    Override with DOCUSIGN_OAUTH_REDIRECT_URI if needed
# 3. Template may have one claimant role; the app adds a witness signer automatically at Stage 2
#    Optional: add a second "Witness" role in DocuSign instead (recommended for fixed tab placement)
# 4. Set DOCUSIGN_TEMPLATE_ROLE_NAME to the claimant role name in the template
# 5. Optional witness tab offset when using a single-role template (pixels below claimant signature):
# DOCUSIGN_WITNESS_SIGN_Y_OFFSET=80
# 5. DocuSign Connect webhook (avoids polling rate limits):
#    a) DocuSign Admin → Connect → Connect Keys → Add Secret Key (copy into DOCUSIGN_WEBHOOK_HMAC_SECRET)
#    b) Set APP_BASE_URL to your public site (e.g. https://46-101-60-110.sslip.io)
#       Webhook URL: {APP_BASE_URL}/api/docusign/webhook
#    c) Optional override: DOCUSIGN_WEBHOOK_URL=https://your-domain/api/docusign/webhook
#    DocuSign requires HTTPS for envelope webhooks — http://localhost will NOT work.
#    Local dev: leave DOCUSIGN_WEBHOOK_HMAC_SECRET unset (or placeholder) and use Refresh status.
#    Local webhook test: ngrok http 3000 → DOCUSIGN_WEBHOOK_URL=https://xxx.ngrok.app/api/docusign/webhook
DOCUSIGN_ENV=demo
DOCUSIGN_ACCOUNT_ID=...
DOCUSIGN_INTEGRATION_KEY=...
DOCUSIGN_USER_ID=...
DOCUSIGN_PRIVATE_KEY=...
DOCUSIGN_TEMPLATE_ID=...
# Match the exact role names shown in DocuSign template editor (case-insensitive OK)
DOCUSIGN_TEMPLATE_ROLE_NAME=signer
DOCUSIGN_WITNESS_ROLE_NAME=witness
DOCUSIGN_WEBHOOK_HMAC_SECRET=...

# Email — Zoho Mail Pro EU
# DigitalOcean blocks outbound SMTP (25/465/587). smtppro.zoho.eu will time out.
# Use the Zoho Mail HTTPS API (port 443) on the droplet.
#
# 1. https://api-console.zoho.eu/ → Add Client → Self Client
# 2. Put Client ID / Secret below. Generate Code with scopes:
#      ZohoMail.messages.CREATE,ZohoMail.accounts.READ
# 3. npm run zoho-mail-token -- <grant-code>
# 4. Paste ZOHO_REFRESH_TOKEN, keep EMAIL_TRANSPORT=zoho, restart the API
#
EMAIL_TRANSPORT=zoho
ZOHO_REGION=eu
ZOHO_PRO=true
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# ZOHO_ACCOUNT_ID=   # optional; discovered from EMAIL_FROM if omitted
EMAIL_FROM="FIPO <you@yourdomain.com>"
EMAIL_FROM_NAME=FIPO
SMTP_USER=you@yourdomain.com
#
# SMTP is only useful off DigitalOcean (local laptop). Leave blank on the droplet.
# SMTP_HOST=smtppro.zoho.eu
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_PASS=
#
# Optional: Zoho ZeptoMail instead of Mail API (one send-mail token, also HTTPS)
# EMAIL_TRANSPORT=zeptomail
# ZEPTOMAIL_TOKEN=
#
# Local dev without Zoho: leave EMAIL_TRANSPORT unset → [EMAIL:STUB]
APP_BASE_URL=http://localhost:3000
